# ===========================================================================
# db-refresh — plantilla de configuración. Copiar a .env y rellenar.
# NUNCA commitear el .env real ni el JSON de la service account.
# ===========================================================================

# --- App / servidor ---
NODE_ENV=development
# En dev, el proxy de Vite (web/vite.config.js) lee este mismo PORT del .env de
# la raíz, así que basta con cambiarlo aquí.
PORT=3004
LOG_LEVEL=info

# --- Exposición HTTP ---
# HTTPS_ENABLED: ¿la app se sirve por HTTPS? Controla cookie Secure, HSTS y la
# directiva CSP upgrade-insecure-requests. Vacío = true si NODE_ENV=production.
# Acceso por IP:puerto sin dominio/TLS (1ª etapa en el VPS): HTTPS_ENABLED=false.
# Al poner dominio + TLS (Caddy/Nginx), volver a true (o quitar la línea).
HTTPS_ENABLED=
# TRUST_PROXY: saltos de proxy de confianza para req.ip (rate-limit, auditoría).
# Vacío = 1 (dev con Vite / tras reverse proxy). API expuesta DIRECTA: TRUST_PROXY=false
# (si no, X-Forwarded-For es falsificable y se salta el rate-limit de login).
TRUST_PROXY=
# Express sirve el build del frontend (web/dist) en el mismo puerto que la API si
# existe. SERVE_WEB=false si lo sirve Nginx/CDN. WEB_DIST_DIR cambia la ruta.
SERVE_WEB=true

# --- BD de la aplicación (PostgreSQL 17) ---
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=db_refresh
APP_DB_USER=db_refresh
APP_DB_PASSWORD=changeme
APP_DB_POOL_MAX=10

# --- Autenticación ---
JWT_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_EXPIRES_IN=8h

# Admin base garantizado en la BD al arrancar la API (para no quedar bloqueado).
# Si no existe, se crea con estos valores. NO resetea el password si ya existe.
# Cambia el password por defecto cuanto antes. Pon BASE_ADMIN_ENABLED=false para desactivarlo.
BASE_ADMIN_ENABLED=true
BASE_ADMIN_EMAIL=admin@dbrefresh.local
BASE_ADMIN_PASSWORD=P4$$w0rD

# Master key para cifrar los settings sensibles guardados en la BD
# (password de bind AD, JSON de la service account de GCP). AES-256-GCM.
# Generar: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# OBLIGATORIA si se van a configurar AD/GCP desde el módulo de settings.
APP_ENCRYPTION_KEY=cambiar-por-clave-de-32-bytes-base64

# AD / LDAP — FALLBACK opcional. Preferir configurarlo en Ajustes > AD / LDAP
# (PUT /api/settings/ad), que lo guarda en la BD (bind password cifrada). Estos
# valores solo se usan si no hay config AD en la tabla app_settings.
# Los usuarios de AD deben darse de alta antes en Usuarios (tipo AD).
#   AD_MODE=direct  -> bind con DOMINIO\usuario (requiere AD_DOMAIN; AD_BASE_DN opcional)
#   AD_MODE=search  -> cuenta de servicio (requiere AD_BIND_DN, AD_BIND_PASSWORD, AD_BASE_DN)
#   AD_SECURITY=starttls (ldap://, 389, recomendado) | ldaps (ldaps://, 636) | none
AD_URL=
AD_MODE=direct
AD_DOMAIN=
AD_SECURITY=starttls
AD_BASE_DN=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_USER_FILTER=(sAMAccountName={{username}})
AD_TLS_REJECT_UNAUTHORIZED=true

# --- Restore nativo de PostgreSQL (pg_restore / psql) ---
# Carpeta de los binarios; vacío = los del PATH (Ubuntu: apt install postgresql-client-17).
PG_BIN_DIR=
# Tiempo máximo de cada pg_restore/psql (segundos).
NATIVE_RESTORE_TIMEOUT_SECONDS=10800

# --- GCP (Service Account / IAM) ---
# FALLBACK opcional. Preferir subir el JSON de la SA por el módulo de settings
# (PUT /api/settings/gcp), que lo guarda cifrado en la BD. Esta ruta (ADC) solo
# se usa si no hay SA configurada en app_settings. En prod: Secret Manager / WI.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Worker de jobs ---
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=5000
OPERATION_TIMEOUT_SECONDS=10800
OPERATION_POLL_INTERVAL_SECONDS=30
# Pre-check: segundos que se espera a que la instancia quede libre de
# operaciones (backup automático, otro import) antes de abortar sin tocar nada.
INSTANCE_IDLE_WAIT_SECONDS=900
# Timeout (ms) de cada lote GO de un post-script SQL.
POST_SCRIPT_TIMEOUT_MS=600000

# --- Password de las instancias (secret_ref del catálogo) ---
# El catálogo guarda una REFERENCIA, nunca el password:
#   sm://projects/<p>/secrets/<s>[/versions/<v>]  -> Secret Manager (con la SA de settings)
#   env:NOMBRE_VARIABLE                           -> variable de entorno (solo dev)
# Ejemplo dev: secret_ref = env:CSQL_HOMOLOGACION_PASSWORD
# CSQL_HOMOLOGACION_PASSWORD=
