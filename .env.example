# ===========================================================================
# db-refresh — plantilla de configuración. Copiar a .env y rellenar.
# NUNCA commitear el .env real ni el JSON de la service account.
# ===========================================================================

# --- App / servidor ---
NODE_ENV=development
# En dev, el proxy de Vite (web/vite.config.js) lee este mismo PORT del .env de
# la raíz, así que basta con cambiarlo aquí.
PORT=3004
LOG_LEVEL=info

# --- BD de la aplicación (PostgreSQL 17) ---
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=db_refresh
APP_DB_USER=db_refresh
APP_DB_PASSWORD=changeme
APP_DB_POOL_MAX=10

# --- Autenticación ---
JWT_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_EXPIRES_IN=8h

# Admin base garantizado en la BD al arrancar la API (para no quedar bloqueado).
# Si no existe, se crea con estos valores. NO resetea el password si ya existe.
# Cambia el password por defecto cuanto antes. Pon BASE_ADMIN_ENABLED=false para desactivarlo.
BASE_ADMIN_ENABLED=true
BASE_ADMIN_EMAIL=admin@dbrefresh.local
BASE_ADMIN_PASSWORD=P4$$w0rD
# Rol de un usuario de AD la primera vez que entra (viewer|operator|admin)
AD_DEFAULT_ROLE=viewer

# Master key para cifrar los settings sensibles guardados en la BD
# (password de bind AD, JSON de la service account de GCP). AES-256-GCM.
# Generar: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# OBLIGATORIA si se van a configurar AD/GCP desde el módulo de settings.
APP_ENCRYPTION_KEY=cambiar-por-clave-de-32-bytes-base64

# AD / LDAP — FALLBACK opcional. Preferir configurarlo por el módulo de settings
# (PUT /api/settings/ad), que lo guarda cifrado en la BD. Estos valores solo se
# usan si no hay config en la tabla app_settings.
AD_URL=
AD_BASE_DN=
AD_BIND_DN=
AD_BIND_PASSWORD=

# --- GCP (Service Account / IAM) ---
# FALLBACK opcional. Preferir subir el JSON de la SA por el módulo de settings
# (PUT /api/settings/gcp), que lo guarda cifrado en la BD. Esta ruta (ADC) solo
# se usa si no hay SA configurada en app_settings. En prod: Secret Manager / WI.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Worker de jobs ---
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=5000
OPERATION_TIMEOUT_SECONDS=10800
OPERATION_POLL_INTERVAL_SECONDS=30
