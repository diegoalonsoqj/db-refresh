{
  "name": "db-refresh",
  "version": "0.1.0",
  "description": "Orquestador de restauración de backups multi-motor en Cloud SQL (GCP)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "worker": "node server/jobs/worker.js",
    "scheduler": "node server/jobs/scheduler.js",
    "migrate": "node db/migrate.js",
    "seed:admin": "node db/seed-admin.js",
    "test": "node --test"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@googleapis/sqladmin": "^11.0.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^7.2.1",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  }
}
